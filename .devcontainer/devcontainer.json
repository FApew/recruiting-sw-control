{
    "name": "Eagle ROS2",
    "build": {
        "dockerfile": "../docker/Dockerfile"
    },
    "workspaceFolder": "/home/eagle/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/eagle/ws,type=bind",
    "runArgs": [
        "--network=host",
        "--cap-add=NET_ADMIN"
    ],
    "remoteUser": "eagle"
}

